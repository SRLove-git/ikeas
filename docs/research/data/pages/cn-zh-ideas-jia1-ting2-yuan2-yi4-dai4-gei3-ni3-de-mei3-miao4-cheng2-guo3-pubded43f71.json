   "items": [
    {
     "title": "在类似于厨房的环境中，由粗木制成的操作台面四周摆放着植物和一盘新鲜的绿色植物。",
     "text": "",
     "image": "https://file.app.ikea.cn/images/29/ab/29abe2d1ffade355226c28cccc19bfce.jpg",
     "href": null,
     "backgroundColor": null
