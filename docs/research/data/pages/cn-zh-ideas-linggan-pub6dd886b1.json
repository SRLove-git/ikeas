   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "Jules，Alhadj和Justus的照片。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/d3/8e/d38e27ebd42c7a35ae3b0cd11d93ff87.jpg"
   ],
   "links": [
    {
