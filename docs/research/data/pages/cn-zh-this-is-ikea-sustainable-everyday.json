   "items": [
    {
     "title": "向循环企业转型",
     "text": "宜家正积极转型为循环型企业。我们致力于开发创新的产品和服务，帮助顾客更好地维护、修理和转让他们的物品。",
     "image": "https://file.app.ikea.cn/content/u/20250506/16B611DF-CC29-4B1D-9C8158479D3CBBE5.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/this-is-ikea/climate-environment/becoming-a-circular-business-pubeabc21b6",
     "backgroundColor": "#f5f5f5"
    },
    {
     "title": "气候行动",
     "text": "如果我们希望让地球环境更适宜子孙后代繁衍生息，我们就需要在世界各地采取切实有效、有组织且富有创意的行动。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/91A969AB-B2CD-49A1-866FD2B82E5442F7/main-v1.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/this-is-ikea/climate-environment/qi4-hou4-xing2-dong4-pub195d8026",
     "backgroundColor": "#f5f5f5"
    },
    {
     "title": "零碳排配送目标  ",
     "text": "宜家致力于使用零排放配送车辆，以减少碳排放及气候足迹。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/5FE00697-11B1-4384-93F4A143E0404250/main-v1.png?x-oss-process=style/medium",
     "href": "/cn/zh/this-is-ikea/climate-environment/zero-emission-ikea-deliveries-pub4a1e929a",
     "backgroundColor": "#f5f5f5"
    },
    {
     "title": "宜家2030年可持续发展目标",
     "text": "宜家可持续发展战略提出了我们的转变宜家业务模式的目标：推动整个宜家价值链转型、改变世界各地人们的居家生活方式。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/408ED889-F68A-4F7E-A4F34455FEEF6E2E/main-v1.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/this-is-ikea/climate-environment/the-ikea-sustainability-strategy-pubb8f1aa35",
     "backgroundColor": "#f5f5f5"
    }
   ],
