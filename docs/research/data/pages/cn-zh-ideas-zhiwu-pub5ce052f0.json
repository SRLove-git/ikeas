   "title": null,
   "texts": [
    "将刚剪下的茎放入水中。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/0b/26/0b261b0f0382c3121c215d59e3872f08.jpg"
   ],
