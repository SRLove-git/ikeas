   "texts": [
    "装饰自己的家，展现生活激情",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/b6/b4/b6b49fbedf512b2ec9f4739c575a4b43.jpg"
   ],
   "links": [
