   "texts": [
    "Kasia手工制作的纺织品为家增添个性色彩",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/8f/75/8f75178110a2ed4329e042541393b609.jpg"
