   "type": "pub-curated-gallery",
   "title": "来看看我可爱的水槽？",
   "texts": [
    "/rooms/living-room/how-to/rang4-jia1-ju1-geng4-cong1-ming2-pubc47eef40",
    "NO",
    "ikea://cms/page-compatible-web?url=%2Frooms%2Fliving-room%2Fhow-to%2Frang4-jia1-ju1-geng4-cong1-ming2-pubc47eef40&key=cn--zh--c47eef40c52f11eb929fff34060b2457",
