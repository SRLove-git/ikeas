   "title": null,
   "texts": [
    "阳台上摆着搁架单元，用于储物和进行园艺工作。",
    "IMAGE",
    "MANUAL_INPUT",
    "80291892"
   ],
   "images": [
    "https://file.app.ikea.cn/images/4b/34/4b3422740c1c8cbe3190187aed532f82.jpg"
   ],
   "links": [
