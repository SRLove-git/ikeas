   "items": [
    {
     "title": "",
     "text": "走廊里铺着瓷砖，映照在紫色的灯光下，KVITTERA 柯提拉 上菜架上摆放着欢迎甜点，STORSINT 斯图辛特 酒杯中则斟上了佳酿。",
     "image": "https://file.app.ikea.cn/ext/ingkadam/m/be301674b614a98/original/PH168887-crop001.jpg",
     "href": null,
     "backgroundColor": null
    }
