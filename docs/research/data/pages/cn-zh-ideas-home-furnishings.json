   "items": [
    {
     "title": "时尚怡人的家居布置技巧和创意",
     "text": "美学优先还是儿童友好优先？看看这间公寓，它在为儿童带来欢乐和美观时尚之间实现了完美的平衡。",
     "image": "https://file.app.ikea.cn/images/81/cd/81cd89387684d87ef3873f5c079c6f69.jpg",
     "href": "/cn/zh/ideas/home-furnishings/lets-get-creative-a-welcoming-apartment-puba2b948f9",
     "backgroundColor": null
    },
    {
     "title": "利用节省空间的技巧和创意来优化小家",
     "text": "你是否在为如何充分利用你的小家而苦恼？来看看这间紧凑型公寓，从它节省空间的建议和技巧中汲取一些灵感吧！",
     "image": "https://file.app.ikea.cn/images/1a/ca/1aca949f8d7a55b1a86da4f52a7413ba.jpg",
     "href": "/cn/zh/ideas/home-furnishings/a-full-life-in-a-small-apartment-pube4855056",
     "backgroundColor": null
    },
    {
     "title": "生活和娱乐皆宜的时尚公寓",
     "text": "创造一个色彩缤纷的家，既能彰显个性，又具有实用性。从用餐到放松身心，寻找可以同时满足两种需求的家具解决方案。",
     "image": "https://file.app.ikea.cn/images/b4/21/b4215932bf54df31dd6659b90962056e.jpg",
     "href": "/cn/zh/ideas/home-furnishings/living-easy-an-urban-apartment-designed-for-the-good-times-pub3c93df49",
     "backgroundColor": null
    },
    {
     "title": "其乐融融的多代同堂大家庭",
     "text": "营造温馨的大家庭氛围又不失个人隐私，借助收纳小妙招和多功能空间让每个家庭成员都能从容享受日常生活。",
     "image": "https://file.app.ikea.cn/images/5a/e6/5ae6062f343fbc5d434159de03c2b394.jpg",
     "href": "/cn/zh/ideas/home-furnishings/welcome-to-the-multigenerational-home-pub336467bc",
     "backgroundColor": null
    },
    {
     "title": "如何打造简单舒适的家庭居所",
     "text": "想打造一个简约的家庭居所？这个家庭空间的布置结合了智能解决方案与耐用的家装产品，巧妙演绎简约风格，可以带给你启发和灵感。",
     "image": "https://file.app.ikea.cn/images/6f/53/6f53411b7930d67da99cc0b5f242f2a7.jpg",
     "href": "/cn/zh/ideas/home-furnishings/pin3-zhi4-sheng1-huo2-jian3-yue1-de5-jia1-ting2-ju1-suo3-pub927e4abe",
     "backgroundColor": null
    },
    {
     "title": "为同住室友保留隐私与创意空间",
     "text": "你是否与室友同住，需要在隐私和亲密之间找到平衡？那就看看这个启发灵感的大家庭吧。",
     "image": "https://file.app.ikea.cn/images/0d/63/0d63a5b7645933505081f2f7798c0ffe.jpg",
     "href": "/cn/zh/ideas/home-furnishings/a-shared-home-for-privacy-and-play-pub261fc473",
     "backgroundColor": null
    },
    {
     "title": "独处和相伴皆宜的时尚合住空间",
     "text": "你是否和室友同住，想要打造独处和相伴皆宜的家居空间？不妨参观一下这个空间的设计，从中寻找灵感！",
     "image": "https://file.app.ikea.cn/images/15/ed/15ed344c55bdda338cb43828f7140e20.jpg",
     "href": "/cn/zh/ideas/home-furnishings/divide-and-conquer-privacy-for-all-in-a-shared-home-pub47938b19",
     "backgroundColor": null
    },
    {
     "title": "布置有格调的组合家庭住房",
     "text": "打算开启合住生活了？不妨来参观一下这个重组家庭的住所，他们采用了混搭式布置风格，每个人都有属于自己的空间。",
     "image": "https://file.app.ikea.cn/images/87/41/8741a05c8f3b47130489c0e45a2f0e64.jpg",
     "href": "/cn/zh/ideas/home-furnishings/blended-a-combined-household-with-space-for-a-big-family-pub99f7fa15",
     "backgroundColor": null
    },
    {
     "title": "充满乐趣的经济型小公寓",
     "text": "在经济型的家庭住宅中充分利用空间，布置多功能家具，并利用储物小妙招轻松应对不时之需。多花点心思就行了！",
     "image": "https://file.app.ikea.cn/images/58/4c/584c92b770437459cceba8e3ce2c8a8f.jpg",
     "href": "/cn/zh/ideas/home-furnishings/imagination-station-a-small-budget-friendly-apartment-for-two-pub9e1cc70c",
     "backgroundColor": null
    },
    {
     "title": "小公寓的设计和布置创意",
     "text": "在寻找小公寓的设计创意？这是一对情侣合住的单间公寓，风格时尚，注重装饰，你不妨参观一番，从中找些灵感。",
     "image": "https://file.app.ikea.cn/images/d7/11/d7113b3c619573061b5af954f023bcc3.jpg",
     "href": "/cn/zh/ideas/home-furnishings/modern-life-a-decor-centric-small-apartment-for-living-well-pub7be50108",
     "backgroundColor": null
    },
    {
     "title": "一个经济实惠的单间公寓",
     "text": "因预算有限，你住在一间小公寓里吗？仔细看看这个时尚的小型单间公寓，获取一些节省空间的灵感！",
     "image": "https://file.app.ikea.cn/images/1e/51/1e51cae5449bc30981d4cce9e4ce91f4.jpg",
     "href": "/cn/zh/ideas/home-furnishings/living-solo-a-small-budget-friendly-studio-apartment-pub6f138c42",
     "backgroundColor": null
    }
   ],
