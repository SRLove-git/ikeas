   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "一位母亲和她的两个孩子身着万圣节游戏服装在愉快地制作食物。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/78/1e/781e5e1a3f53640394f21d665175957e.jpg"
   ],
   "links": [
    {
