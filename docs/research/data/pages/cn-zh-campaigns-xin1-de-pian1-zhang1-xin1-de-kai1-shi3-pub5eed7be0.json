  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><strong>社会新人</strong> | <a href=\"#5f091d60-bfff-11ea-a26e-65db6194def7\">大学生</a> | <a href=\"#28c90900-c003-11ea-a26e-65db6194def7\">中小学生</a></p>"
