   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "浅色布料和蕾丝垂挂在开放式衣柜前面。",
    "IMAGE",
    "MANUAL_INPUT",
    "40171863"
   ],
   "images": [
    "https://file.app.ikea.cn/images/19/58/1958531d9fd23734fc97361ee4bc5ae0.jpg"
