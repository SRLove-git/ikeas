   "items": [
    {
     "title": "节约用水",
     "text": "通过重新审视家庭生活习惯，你每天可以节约很多水。了解一下宜家提供的家庭节水智能解决方案。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/7540F004-571D-4F44-8B05FE48EA2CB1CD/main-v1.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/ideas/tips-for-more-sustainable-living/smart-solutions-to-save-water-at-home-pubfdfe8c45",
     "backgroundColor": "#37b886"
    },
    {
     "title": "选择更优质的食品",
     "text": "食物的选择会产生不同的影响，从植物性食物到来自负责任来源的认证产品。发现更多简单的方法，轻松实现更可持续的饮食。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/C77A8B9D-42C4-4E6C-82DF27BA74517684/main-v1.png?x-oss-process=style/medium",
     "href": "/cn/zh/ideas/tips-for-more-sustainable-living/easy-wins-to-eating-more-sustainably-pubdbfa9a20",
     "backgroundColor": "#37b886"
    },
    {
     "title": "减少浪费",
     "text": "即使生活很节俭，也总会有一定数量的生活垃圾。但有一些简单的方法可以重复利用现有物品并减少家里的浪费。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/09FAD1B9-2A0B-470A-88BF916BB68906E1/main-v1.png?x-oss-process=style/medium",
     "href": "/cn/zh/ideas/tips-for-more-sustainable-living/simple-ways-to-reduce-waste-at-home-pubb645fb53",
     "backgroundColor": "#37b886"
    },
    {
     "title": "延长物品使用寿命",
     "text": "重新利用、修复、再利用、转售或回收产品的潜力不断增长。了解有助于延长家具使用寿命的小方法。",
     "image": "https://file.app.ikea.cn/content-space/barn-images/3858A1CF-B80C-4BB0-9ED498389B80743D/main-v1.png?x-oss-process=style/medium",
     "href": "/cn/zh/ideas/tips-for-more-sustainable-living/small-steps-to-give-your-furniture-a-longer-life-pubbcff48fc",
     "backgroundColor": "#37b886"
    }
   ],
