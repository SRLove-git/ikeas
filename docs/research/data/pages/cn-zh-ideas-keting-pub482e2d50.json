  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><strong>1.冬日已经过去&nbsp;&nbsp;</strong>将墙壁上的图片换成装裱的绿叶和奇异小鸟图片，注入一抹热带气息。选择带有春日色调的坐垫，搭配春天的花朵，为沙发带来更加轻快明媚的质感。</p>"
   ],
   "images": [],
   "links": [],
   "settings": null
  },
