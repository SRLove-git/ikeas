    {
     "title": "经典北欧的灰白复古风格厨房",
     "text": "",
     "image": "https://file.app.ikea.cn/cms/u/20260722/e5d7d53a7cea49a8b831b3695e77b9ae.png?x-oss-process=style/medium",
