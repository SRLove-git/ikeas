   "title": null,
   "texts": [
    "野餐篮被漆成游戏垫。",
    "IMAGE",
    "MANUAL_INPUT",
    "90284198"
   ],
   "images": [
    "https://file.app.ikea.cn/images/03/11/03113dfb5ed97e7875330b212c890a1a.jpg"
