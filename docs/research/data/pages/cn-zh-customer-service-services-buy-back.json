   "texts": [
    "<h1 style=\"text-align: center;\"><span style=\"color: #37b886;\">回购与再售服务 轻松焕新生活</span></h1>",
    "#FFFFFF"
   ],
   "images": [],
   "links": [],
   "settings": {
