   "title": null,
   "texts": [
    "用皮质吊带挂在墙上的DIY金属丝灵感板",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/75/be/75becce6ab8d9aa4bf8ea1a049b5c11e.jpg"
