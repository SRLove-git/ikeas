   "title": null,
   "texts": [
    "来自宜家波兰弗罗茨瓦夫商场的员工，是2016年年度宜家商场大奖的获得者。"
   ],
   "images": [],
   "links": [],
   "items": [],
   "productIds": [],
   "settings": null
  },
  {
   "type": "pub-horizontal-line",
   "title": null,
   "texts": [
    "#f5f5f5"
   ],
   "images": [],
   "links": [],
   "items": [],
   "productIds": [],
   "settings": null
