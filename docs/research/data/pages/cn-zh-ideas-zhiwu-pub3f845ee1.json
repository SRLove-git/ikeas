  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "一名女士正在将盒子刷成绿色。",
    "IMAGE",
    "MANUAL_INPUT",
    "10392601"
   ],
   "images": [
    "https://file.app.ikea.cn/images/8a/6b/8a6b968050d5f24732c9c0d332e20f2e.jpg"
