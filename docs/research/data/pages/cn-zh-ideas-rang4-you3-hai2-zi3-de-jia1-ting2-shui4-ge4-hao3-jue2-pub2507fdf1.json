   "texts": [
    "pub-column",
    "在一间儿童房的角落里，床后方的墙上挂着一张床垫，床上和床下均带有储物空间。",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT",
    "80332468"
   ],
   "images": [
    "https://file.app.ikea.cn/images/c1/f4/c1f471796d5e64e2581f05a107d39947.jpg"
   ],
   "links": [
