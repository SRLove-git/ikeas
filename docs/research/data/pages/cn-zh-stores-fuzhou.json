  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><a href=\"#c847817db1c34a2c9a378cd4cf035de4\">商场信息</a> | <a href=\"#861ccd6f1ed24585b8173d43eec8f0fa\">商场活动</a> | <a href=\"#a7af6893c79e42ac89df5ad59e8bd4f8\">商场餐厅</a></p>\n<p><a href=\"#89d67a6cab3145ee9ce487c4a2f82d7a\">宜家俱乐部</a> |&nbsp;<a href=\"#bfcb2cd58019481a8d77e987772fa14e\">宜家对公业务部</a> | <a href=\"#b545f3f9e456483699640a2886d3b74a\">全屋设计</a></p>"
   ],
