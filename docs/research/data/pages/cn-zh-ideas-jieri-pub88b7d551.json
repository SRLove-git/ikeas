   "items": [
    {
     "title": "在这间工业风格的阁楼公寓内，用餐区摆放了一条长凳和一张餐桌，用来供应自助餐。",
     "text": "",
     "image": "https://file.app.ikea.cn/images/ae/10/ae101192f0c00e07268de42fc3bb3170.jpg",
     "href": null,
     "backgroundColor": null
    }
