     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "IMAGE",
    "MANUAL_INPUT",
    "60171329"
   ],
   "images": [
    "https://file.app.ikea.cn/images/e1/4a/e14a17eee08705ae359c425654ccc0e7.jpg"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/e1/4a/e14a17eee08705ae359c425654ccc0e7.jpg",
     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><strong>4.从软木塞变成首饰架&nbsp;</strong>你会收藏瓶子上的软木塞，因为你觉得总有一天能用上吗？现在就是它们派上用场的时候了。将软木塞钉在软木垫上，打造珠宝收纳件。拿一些软木锅垫并在上面钉上软木塞。（我们将软木塞排列整齐。）然后再钉在墙上。</p>"
   ],
   "images": [],
   "links": [],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "IMAGE",
    "MANUAL_INPUT",
    "00289510"
   ],
   "images": [
    "https://file.app.ikea.cn/images/0e/42/0e4259a7417af6f78a660b7a7d3e4fd5.gif"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/0e/42/0e4259a7417af6f78a660b7a7d3e4fd5.gif",
     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><strong>5.从废弃物变成墙壁收纳件&nbsp;</strong>大多数包装都非常适合用作储物件。开裂或破损的物品也不例外。把它们改造成墙壁收纳件吧！找一块板作基底。把物品清洁干净。尝试不同的布局，将物品裁剪成新形状。用强力胶水将所有物品粘起来。再喷上颜料或涂上几层颜料。</p>"
   ],
