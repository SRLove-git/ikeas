     "text": ""
    }
   ],
   "settings": {
    "traceId": "3244947c01fa448a8116c4f8f70d829c"
   }
  },
  {
   "type": "pub-columns",
   "title": null,
   "texts": [
    "pub-column",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT",
    "<p>这里绿植环绕，目光所及之处一派自然清新，堪称令人向往的花园式理想办公区。</p>",
    "pub-text"
   ],
   "images": [
    "https://file.app.ikea.cn/images/fe/e3/fee3036cfbad410284e1cd13dfdbacff.jpg"
   ],
