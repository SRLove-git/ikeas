    "pub-column",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/3a/b7/3ab7388bc1f15817ec96b90d68f9ef56.jpg"
