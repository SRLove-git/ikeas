   "texts": [
    "pub-column",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/3f/15/3f15992c83b818302431cfb0a4254dd9.jpg"
   ],
   "links": [
