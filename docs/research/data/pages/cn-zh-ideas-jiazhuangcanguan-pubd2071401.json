   "title": null,
   "texts": [
    "Anita的照片。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/12/57/1257486ae2d8817cd803407cbde12ef7.jpg"
