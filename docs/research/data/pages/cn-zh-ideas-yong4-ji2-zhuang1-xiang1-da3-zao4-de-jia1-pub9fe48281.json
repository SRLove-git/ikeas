   "title": null,
   "texts": [
    "pub-column",
    "一张带轮子的桌子，下面有储物篮；两个小凳子和一张坐卧两用床。",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT",
    "s89130041"
   ],
   "images": [
    "https://file.app.ikea.cn/images/70/06/7006d84c37420077c000874a4db21a73.jpg",
