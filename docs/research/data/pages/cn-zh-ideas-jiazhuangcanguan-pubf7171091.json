   "type": "pub-image",
   "title": null,
   "texts": [
    "Litao和Tianye坐在沙发上共进晚餐。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/45/7a/457a9577e70bfdcf4727cd290ffc8077.jpg"
