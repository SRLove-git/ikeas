    "一木碗腰果奶油配百里香",
    "IMAGE",
    "MANUAL_INPUT",
    "80222974"
   ],
   "images": [
    "https://file.app.ikea.cn/images/8e/3f/8e3fe61c2415ee98cd72b3813a60f566.jpg"
