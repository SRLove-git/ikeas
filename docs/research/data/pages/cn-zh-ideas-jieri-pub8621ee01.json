   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "舒适的卧室里放着一张床，床头板的中间亮着一盏阅读灯。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/ec/34/ec34b1aea8446c56a7d0a41305951b01.jpg"
   ],
   "links": [
    {
