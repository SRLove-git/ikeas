    }
   ],
   "items": [
    {
     "title": "用手推车、储物柜和小桌子在阳台上打造一块准备和享受美食的空间。",
     "text": "",
     "image": "https://file.app.ikea.cn/images/49/ae/49ae25bb8f40d1273c511a64a5c648eb.jpg",
     "href": null,
     "backgroundColor": null
    }
