   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "随性是Jerzy和Anna烹饪的重要风格。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/d6/4b/d64ba08ceaa03d489cd27fffb396a33f.jpg"
   ],
   "links": [
    {
