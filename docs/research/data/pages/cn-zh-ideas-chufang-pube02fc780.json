   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<h3>休闲美食</h3> <p>打造一张自助餐式餐桌。每个人贡献一份美食，合起来就是令人激动的丰盛大餐。</p>"
   ],
