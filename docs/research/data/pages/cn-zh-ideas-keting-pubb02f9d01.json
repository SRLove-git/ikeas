   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "打造同款客厅所需物品清单。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/e3/ad/e3add2d2fac141f2aa1abfc04aa1fea2.jpg"
   ],
   "links": [
