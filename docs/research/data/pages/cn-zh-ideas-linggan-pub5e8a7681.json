   "texts": [
    "展示你最喜欢的收藏。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/fd/3c/fd3ccd61610504b61d2c3f6ac6e6bacc.jpg"
   ],
   "links": [
