     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "一名女性在 KNODD 克诺德 垃圾桶装皮革把手。",
    "IMAGE",
    "MANUAL_INPUT",
    "30348928",
    "20312251"
   ],
   "images": [
    "https://file.app.ikea.cn/images/5f/76/5f7688838e4dfd2ee3e66e2ebadaf526.jpg"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/5f/76/5f7688838e4dfd2ee3e66e2ebadaf526.jpg",
     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p><strong>3.拧下 KNODD 克诺德 垃圾桶的金属把手</strong>，换上一对迷人的皮革把手，为它增添质朴精致之感。这是收集木柴的绝佳方式。</p>"
   ],
   "images": [],
   "links": [],
   "settings": null
  },
  {
