     "image": "https://file.app.ikea.cn/content/u/20250116/AF2335FC-D28F-4D74-85BE607BB8C6C485.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/outdoor/gallery/lv4-yi4-ying2-rao3-ning2-jing4-qing1-you1-de5-xiao3-yang2-tai2-pubf87b0a34",
     "backgroundColor": null
    },
