    "MANUAL_INPUT",
    "pub-quote",
    "玩玩具是激发学习和开发技能最为轻松的方式"
   ],
   "images": [
    "https://file.app.ikea.cn/images/c3/a6/c3a68bec625e0ad497ae2d03c76f4ce2.jpg"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/c3/a6/c3a68bec625e0ad497ae2d03c76f4ce2.jpg",
     "text": ""
    }
   ],
   "settings": null
