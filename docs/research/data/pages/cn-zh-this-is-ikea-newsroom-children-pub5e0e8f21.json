    }
   ],
   "settings": null
  },
  {
   "type": "pub-columns",
   "title": null,
   "texts": [
    "pub-column",
    "pub-image",
    "IMAGE",
    "MANUAL_INPUT",
    "<h3><em><strong>&rdquo;这是人类不断发展的方式。我们通过接触事物、与同龄人互动、用眼睛识别事物、辨别颜色及数数等方式来学习。</strong></em></h3>",
    "pub-text"
   ],
   "images": [
    "https://file.app.ikea.cn/images/94/94/949415f11438bbefa21bfbf0b8c3a18a.jpg"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/94/94/949415f11438bbefa21bfbf0b8c3a18a.jpg",
     "text": ""
    }
   ],
   "settings": null
