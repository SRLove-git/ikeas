    "<p><strong><span style=\"font-size: 10.0pt;\">营业时间</span></strong></p>\n<p><strong><span style=\"font-size: 10.0pt; color: black;\">商场：</span></strong></p>\n<p><span style=\"font-size: 10.0pt; color: black;\">周一至周日：10:00-22:00</span></p>\n<p><strong><span style=\"font-size: 10.0pt; color: black;\">顾客餐厅：</span></strong></p>\n<p><span style=\"font-size: 10.0pt; color: black;\">周一至周五：10:00-20:30</span></p>\n<p><span style=\"font-size: 10.0pt; color: black;\">周六至周日：10:00-21:00</span></p>"
