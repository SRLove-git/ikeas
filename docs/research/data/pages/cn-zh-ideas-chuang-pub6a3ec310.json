   "texts": [
    "可将门厅里的宜家 TRONES 强尼思 鞋柜安装到狗床上方，用于存放狗狗的用品。",
    "IMAGE",
    "MANUAL_INPUT",
    "00189087"
   ],
   "images": [
    "https://file.app.ikea.cn/images/8c/a0/8ca055675fd225309ddf3fd17a6f7da6.jpg"
   ],
   "links": [
