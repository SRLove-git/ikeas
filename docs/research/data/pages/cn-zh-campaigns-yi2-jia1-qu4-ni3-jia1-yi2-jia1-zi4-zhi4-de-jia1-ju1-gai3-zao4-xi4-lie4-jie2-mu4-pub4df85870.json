   "type": "pub-text",
   "title": null,
   "texts": [
    "<p>作为一家社会创新机构的主理人，阿菜一直提倡可持续的生活方式。但他和同事搬入新家后发现，屋内的各种限制同他们一贯的生活理念形成了明显的冲突。</p>"
   ],
   "images": [],
   "links": [],
   "settings": {
    "traceId": "d3752240091644d3bdf5ac2f6cedfdc0"
   }
  },
