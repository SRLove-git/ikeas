   ],
   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<p>一睹 IKEA PS 2017 系列的迷人风采&mdash;&mdash;由来自全球的17位设计师共同设计。</p>"
   ],
   "images": [],
   "links": [],
   "settings": null
