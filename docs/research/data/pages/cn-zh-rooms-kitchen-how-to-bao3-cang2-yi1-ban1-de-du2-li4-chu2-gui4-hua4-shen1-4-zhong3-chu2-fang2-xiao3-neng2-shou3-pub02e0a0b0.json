     "text": ""
    },
    {
     "href": "https://file.app.ikea.cn/cms/u/20250710/38f4728c3f534e5abdcdaea63aac6bf2.jpg?x-oss-process=style/medium",
     "text": ""
    },
    {
     "href": "https://file.app.ikea.cn/content/u/20250106/5AAAD4EA-6AFB-49EA-A8DA46E8DB97C367.jpg?x-oss-process=style/medium",
