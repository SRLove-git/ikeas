    "https://file.app.ikea.cn/content-space/barn-images/59EF1CCC-E9F9-486A-BD8E72EA0B2B46CA/main-v1.jpg?x-oss-process=style/medium"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/content/u/20251021/DB910470-CD71-4A02-8545A992EC750418.jpg?x-oss-process=style/medium",
