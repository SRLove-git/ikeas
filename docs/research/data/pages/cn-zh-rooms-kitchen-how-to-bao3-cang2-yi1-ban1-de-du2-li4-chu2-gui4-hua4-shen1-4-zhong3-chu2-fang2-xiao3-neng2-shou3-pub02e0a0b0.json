   "items": [
    {
     "title": "肉桂煎苹果粥",
     "text": "以这碗简单美味的肉桂煎苹果粥，开启理想周末。立即查看食谱，享受美味秋晨吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250708/8d2601cb38dc4aa6807ad8e631c9df96.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/porridge-with-cinnamon-fried-apples-pub88cc8b22",
     "backgroundColor": null
    },
    {
     "title": "香蕉幽灵冰棒",
     "text": "准备好享受冰爽吧！这些惊悚万圣节冰棒，从制作到品尝都充满尖叫乐趣。非常适合居家惊悚之夜。马上试试吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250708/8743a6d37e9944d1aac6028470eb8fab.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/frosty-banana-ghosts-puba885d501",
     "backgroundColor": null
    },
    {
     "title": "毛骨悚然又可爱的蜘蛛肉丸",
     "text": "盘中惊悚的趣味感！这些令人毛骨悚然的可爱蜘蛛肉丸制作简单，非常适合万圣节盛宴。今天就做一份吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250708/ddf38417ff9446e8958ff9531eaface9.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/spider-meatballs-pubb3780130",
     "backgroundColor": null
    },
    {
     "title": "美味木乃伊肉丸——万圣节绝佳之选！",
     "text": "享用美味木乃伊肉丸，感受万圣节的气氛！一起制作简单有趣的小吃。今天就试试这个食谱，我们向你发起挑战！",
     "image": "https://file.app.ikea.cn/cms/u/20250708/b1bb8529960244e2850398751da29bf6.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/meatball-mummies-pub3aeec011",
     "backgroundColor": null
    },
    {
     "title": "惊悚升级版接骨木汁潘趣酒",
     "text": "让这款惊悚潘趣酒为你的万圣节派对留下难忘的回忆！那只漂浮的冰冻手掌是真正的亮点。今天就试试这个食谱吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250708/9d5d01a6317a4f23bc9435e4deedc00d.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/spooky-punch-pub90cd71df",
     "backgroundColor": null
    },
    {
     "title": "浓郁美味的姜汁南瓜汤",
     "text": "将万圣节的南瓜边角料变成香浓暖心的南瓜浓汤！适合寒冷夜晚的秋季舒心美食。今天就试试这个食谱吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/1dfae58b382445d0ac695d4715ad0e62.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/pumpkin-soup-pub730a82fe",
     "backgroundColor": null
    },
    {
     "title": "香料苹果肉桂茶",
     "text": "品尝苹果肉桂茶，感受惬意的瑞典风味！一杯暖香四溢的香料茶，宛如寒冷天气里温暖的拥抱。马上来体验一下吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/521b4c1cd3cb43b6858836d6f9274221.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/spiced-apple-tea-pubaf4f3413",
     "backgroundColor": null
    },
    {
     "title": "还有没吃完的南瓜？制作一份美味沙拉",
     "text": "用没吃完的奶油南瓜制作这道暖心的烤蔬菜沙拉，不仅避免了浪费，而且简单易做、滋味可口，非常适合作为时令餐点。",
     "image": "https://file.app.ikea.cn/cms/u/20250709/504ec2e8054a4cfaaad63ea5bb539263.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/pumpkin-salad-pub52ab4cea",
     "backgroundColor": null
    },
    {
     "title": "甜咸风味南瓜披萨",
     "text": "快来享用甜咸风味南瓜披萨，速享秋日限定美味！非常适合温馨的电影之夜。今天就试试这个食谱吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/dafd81edf6c446d6b5d377b879314615.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/flatbread-pumpkin-pizza-bianca-pubc5a227a2",
     "backgroundColor": null
    },
    {
     "title": "香酥无酵薄饼卷烤甜椒",
     "text": "香脆酥软，美味难挡！这款烤甜椒奶油奶酪无酵薄饼卷，堪称理想的小食。今天就畅享这份美味！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/b9a2c4c23cef4364b507576e6c30a3d0.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/flatbread-pinwheels-with-grilled-peppers-pub3b7da102",
     "backgroundColor": null
    },
    {
     "title": "美味的植物塔可卷",
     "text": "尽情享受酥炸麦块的美味，零负担畅吃！非常适合解馋、影院之夜或制作快手塔可。今天就尽情享受吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/e9340b0d970649888d53d8b85e30da37.JPG",
     "href": "/cn/zh/rooms/kitchen/how-to/plant-based-taco-wraps-pub759eb1e3",
     "backgroundColor": null
    },
    {
     "title": "无酵薄饼配三文鱼、鸡蛋和蛋黄酱",
     "text": "这款美味的无酵薄饼卷，让每餐都升级为精致享受！内馅包含三文鱼、爽脆时蔬与奶油鸡蛋沙拉，15分钟即可享用。马上来体验一下吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/e608e31b66c54e088ae7c59c137353f1.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/flatbread-with-salmon-egg-and-mayonnaise-pub9abab400",
     "backgroundColor": null
    },
    {
     "title": "经典瑞典鲱鱼鸡蛋三明治",
     "text": "尽享美味腌制鲱鱼，体验清爽夏日快餐！这款咸味鲱鱼鸡蛋三明治适合任何场合。马上来体验一下吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/4abcb7b3b27146d085804fd75f0204f6.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/classic-swedish-herring-and-egg-sandwich-pubc63d973d",
     "backgroundColor": null
    },
    {
     "title": "草莓莫吉托无酒精鸡尾酒",
     "text": "清新草莓莫吉托无酒精鸡尾酒，令你畅享沁凉一刻！清爽特调饮品，适合所有欢庆时刻。今天就来调制一杯吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250709/99eba6000f58419aa6e59cc8bec44abd.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/strawberry-mojito-mocktail-pub10f74c10",
     "backgroundColor": null
    },
    {
     "title": "无酒精草莓玛格丽特——夏日佳酿！",
     "text": "啜饮这杯清爽的无酒精草莓玛格丽特！简单易做，适合任何庆祝活动。今天就调制一批吧！",
     "image": "https://file.app.ikea.cn/cms/u/20250710/832705ea1e1f4c9aadea24b5d2e3a472.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/virgin-strawberry-margarita-pubb743ca23",
     "backgroundColor": null
    },
    {
     "title": "品尝美味的LÅNGLUR 隆鲁尔 思慕雪奶昔",
     "text": "只需简单搅拌，就能用LÅNGLUR 隆鲁尔 水果思慕雪制作充满新鲜树莓和红醋的水果奶昔。",
     "image": "https://file.app.ikea.cn/content/u/20250116/BADE27A8-EF4E-47A7-917ADFC565E93119.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/smoothie-milkshake-pub30de1deb",
     "backgroundColor": null
    },
    {
     "title": "品尝美味的LÅNGLUR 隆鲁尔 思慕雪酸奶碗",
     "text": "只需简单混合LÅNGLUR 隆鲁尔 水果思慕雪、全脂酸奶、燕麦片和红浆果，就能制成一份美味的零食。",
     "image": "https://file.app.ikea.cn/content/u/20250116/CD3E9113-ADA7-4F10-BCA8AD84EA063548.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/smoothie-bowl-pub168fbdd1",
     "backgroundColor": null
    },
    {
     "title": "来一杯奇亚籽布丁配思慕雪和燕麦饮",
     "text": "混合咖啡用燕麦奶、LÅNGLUR 隆鲁尔 水果思慕雪和奇亚籽，制成美味的奇亚籽布丁，再搭配酸奶和五彩斑斓的浆果及水果。",
     "image": "https://file.app.ikea.cn/content/u/20250116/70FA520E-F71B-416E-B6E1D68FE0E11304.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/chia-pudding-with-smoothie-and-oat-drink-pubb7b3a926",
     "backgroundColor": null
    },
    {
     "title": "畅享一杯冰爽奶茶",
     "text": "用FLÖJT 夫罗伊 红茶和蜂蜜制成冰块，加入咖啡用燕麦奶，打造一款适合炎炎夏日的清凉饮品。",
     "image": "https://file.app.ikea.cn/content/u/20250116/3ECDBA21-2EF4-4958-905CFEF93D6F6187.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/frozen-tea-cubes-with-milk-pub9ba5a298",
     "backgroundColor": null
    },
    {
     "title": "蔬菜丸子和印度风味炖菜食谱",
     "text": "这是一道美味的素食菜肴，含有印度香料、混合蔬菜和蔬菜球，全家人都会喜欢。访问宜家网站，查看更多食谱。",
     "image": "https://file.app.ikea.cn/content/u/20240925/4E2DA013-6265-468D-A2D9AAF94B0A7D56.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/vegetable-balls-and-indian-style-stew-pub62a86042",
     "backgroundColor": null
    },
    {
     "title": "卷心菜沙拉和鹰嘴豆泥素食碗的食谱",
     "text": "这道卷心菜沙拉和鹰嘴豆泥素食碗将带给你一场感官盛宴。非常适合作为简便的午餐或晚餐。访问宜家网站，查看更多食谱。",
     "image": "https://file.app.ikea.cn/content/u/20240925/8D80FA61-9CCA-4D02-87A010B9E70BAE3B.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/veggie-bowl-with-cabbage-salad-and-hummus-pub56f6ae39",
     "backgroundColor": null
    },
    {
     "title": "含坚果和浆果的燕麦棒食谱",
     "text": "适合全家人共享的随身携带小吃。这些燕麦棒制作起来非常简单，还富含有益健康的成分。访问宜家网站，查看更多食谱。",
     "image": "https://file.app.ikea.cn/content/u/20240925/AD7CFB40-6DC0-410F-8D333CCA18544BC3.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/granola-bars-with-nuts-and-dried-berries-pub6f991f1f",
     "backgroundColor": null
    },
    {
     "title": "泰式素肉丸子汤面食谱",
     "text": "这款泰式汤面以植物蛋白素肉丸、蔬菜和面条烹制而成，让你尽享鲜美的滋味和令人愉快的口感。访问宜家网站，查看更多食谱。",
     "image": "https://file.app.ikea.cn/content/u/20240925/5C9A823D-4A07-4A3A-B46BDBF43B4B080F.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/thai-soup-with-plant-balls-and-noodles-pubdda5ab58",
     "backgroundColor": null
    },
    {
     "title": "红薯蔬菜丸玉米饼食谱",
     "text": "在玉米饼中裹入蔬菜丸、红薯和绵滑的鳄梨酱，为全家人制作一顿色彩缤纷的晚餐。访问宜家网站，查看更多食谱。",
     "image": "https://file.app.ikea.cn/content/u/20240925/D073ACA5-D039-46B1-8620B09D85EDE11A.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/vegetable-ball-tortillas-with-sweet-potato-pub21ea1ffa",
     "backgroundColor": null
    }
   ],
