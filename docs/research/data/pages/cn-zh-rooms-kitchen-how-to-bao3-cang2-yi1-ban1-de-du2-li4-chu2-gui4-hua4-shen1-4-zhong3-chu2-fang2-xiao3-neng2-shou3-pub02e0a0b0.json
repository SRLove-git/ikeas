    {
     "title": "探索理想的学生厨房入门套装",
     "text": " 探索各种经济实惠的厨房必备用品，在大学里更好地下厨烹饪和享用美食。",
     "image": "https://file.app.ikea.cn/content/u/20250313/ECF0D6D3-9548-4D8F-BF45AF4E7F9D5246.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/get-an-a-in-cooking-with-this-student-kitchen-starter-set-pubdcf32844",
     "backgroundColor": null
    },
    {
     "title": " 为功能实用的家庭厨房增添明亮色彩",
     "text": " 为家庭厨房增添明亮、有趣且实用的元素，享受轻松惬意的用餐时光",
     "image": "https://file.app.ikea.cn/cms/u/20250711/657259b8a69b48ab9ad069b9dea5281c.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/a-quick-hop-for-your-kitchen-a-big-leap-for-family-mealtimes-pub3757af7e",
     "backgroundColor": null
    },
    {
     "title": "激发烹饪创意的小厨房",
     "text": "家里空间有限？即使是小厨房也能有大作为。通过合理规划，它可以成为你下厨的得力帮手。立即选购。",
     "image": "https://file.app.ikea.cn/cms/u/20250711/3f42628cadfd4d2a9c61f159218226f2.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/a-small-kitchenette-for-aspiring-content-creators-pubd8d15d36",
     "backgroundColor": null
    },
    {
     "title": "享受烹饪与共处的共享厨房",
     "text": "打造一个温馨又舒适的共享厨房。挑选高品质的座椅、桌子、储物等等，兼顾实用性与趣味性。立即选购。",
     "image": "https://file.app.ikea.cn/cms/u/20250711/afcc3b9bbad442e797a9b6bc0c07e850.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/from-cooking-to-connecting-a-communal-kitchen-that-does-it-all-pubbf4434db",
     "backgroundColor": null
    },
    {
     "title": "为厨房选择操作台面和墙面板",
     "text": "操作台面和墙面板是厨房的重要组成部分，所以我们专门总结了选择操作台面和墙面板的方法。",
     "image": "https://file.app.ikea.cn/cms/u/20250711/3cf50640a39f44d5afb7f8841474f7e8.jpg?x-oss-process=style/medium",
     "href": "/cn/zh/rooms/kitchen/how-to/how-to-choose-the-right-worktop-and-wall-panel-for-your-kitchen-pub8bb1ecf2",
     "backgroundColor": null
    },
    {
     "title": "多款巧妙的厨房多用桌创意，助你打造理想厨房",
     "text": "了解厨房多用桌可以给厨房带来的各种优势，例如额外的工作空间、更多的储物可能性以及美观的聚会场所。",
     "image": "https://file.app.ikea.cn/images/d5/fb/d5fb622bebecbd4cf7dc7d5e6a58e6da.jpg",
     "href": "/cn/zh/rooms/kitchen/gallery/dream-kitchen-island-ideas-for-any-space-pubf8355cc3",
     "backgroundColor": null
    },
    {
     "title": "快速又简便的厨房风格创意",
     "text": "无需过多的预算或精力就能让你的厨房焕然一新。这里有一些在一天之内可以完成的创意。浏览页面获取灵感并在线选购！",
     "image": "https://file.app.ikea.cn/images/55/cd/55cd118774438e2a0b68e628a38d388b.jpg",
     "href": "/cn/zh/rooms/kitchen/how-to/3-ways-to-refresh-the-style-of-your-kitchen-pub2a3b11e9",
     "backgroundColor": null
    },
    {
     "title": "简单的厨房改造创意",
     "text": "正在寻找快速又简便的厨房改造创意？宜家提供的以下创意将帮助你焕新厨房，节约时间，经济实惠。阅读更多。",
     "image": "https://file.app.ikea.cn/images/21/f8/21f84c22f219fb838af18950793905a8.jpg",
     "href": "/cn/zh/rooms/kitchen/how-to/ideas-for-a-simple-kitchen-makeover-puba803f590",
     "backgroundColor": null
    }
