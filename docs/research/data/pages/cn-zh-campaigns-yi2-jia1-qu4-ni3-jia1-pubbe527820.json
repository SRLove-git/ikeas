   "type": "pub-text",
   "title": null,
   "texts": [
    "<h2><strong>全屋设计中心</strong></h2>\n<p>一个理想的家，应该断舍离的永远不是生活本来的乐趣。</p>"
   ],
   "images": [],
   "links": [],
   "settings": {
