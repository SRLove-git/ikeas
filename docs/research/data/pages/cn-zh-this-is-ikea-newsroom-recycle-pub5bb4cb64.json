  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "回收利用塑料。 KUNGSBACKA 孔巴卡 厨房柜门，2017年2月上市。"
   ],
   "images": [],
   "links": [],
   "items": [],
   "productIds": [],
   "settings": null
