     "text": ""
    }
   ],
   "settings": null
  },
  {
   "type": "pub-text",
   "title": null,
   "texts": [
    "<h3>用厨房纺织品打造新外观</h3><p>用布料挂帘将家电隐藏起来，可轻松更换不同图案或颜色。Rebecca说：“我对布料的喜爱源自我的母亲。它们为家增添了一种美妙的质感。”</p>"
   ],
   "images": [],
   "links": [],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
