    "<h2><strong>商场信息</strong></h2>\n<p>11月-2月</p>\n<p><span style=\"color: #111111; background: white;\">商场营业时间：</span><span style=\"color: #111111; background: white;\">10:00-20:00</span><span style=\"color: #111111;\"><br /></span><span style=\"color: #111111; background: white;\">餐厅营业时间： </span><span style=\"color: #111111; background: white;\">9:00-20:00</span></p>\n<p><span style=\"color: #111111; background: white;\">3月-10月</span></p>\n<p><span style=\"color: #111111; background: white;\"><span style=\"color: #111111; background: white;\">商场营业时间：</span><span style=\"color: #111111; background: white;\">10:00-21:0"
