   "texts": [
    "two-columns",
    "column",
    "<h1><span style=\"color: #000000;\">全新设计体验</span></h1>\n<p>超越实体展厅边界，深度诠释宜家在办公场景解决方案领域的专业优势与独特价值。扫码云逛展，为您的办公空间注入更多灵感与启发。</p>",
    "pub-text",
    "NO",
    "pub-image"
