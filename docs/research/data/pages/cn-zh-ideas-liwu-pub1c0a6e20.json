    }
   ],
   "settings": null
  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "图片：制作礼物袋所需的材料。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/3e/25/3e257755cdd31035a07a9e29a92a5f7f.jpg"
   ],
   "links": [
