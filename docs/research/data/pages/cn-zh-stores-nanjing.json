    "<h2><strong>商场信息</strong></h2>\n<p><span style=\"font-size: 11.0pt;\">商场营业时间</span><span style=\"font-size: 11.0pt;\">&nbsp;</span></p>\n<p><span style=\"font-size: 11.0pt;\">工作日</span><span style=\"font-size: 11.0pt;\">10:30-20:30</span></p>\n<p><span style=\"font-size: 11.0pt;\">周末及节假日</span><span style=\"font-size: 11.0pt;\"> 10:00-21:00</span></p>\n<p><span style=\"font-size: 11.0pt;\">&nbsp;</span></p>\n<p><span style=\"font-size: 11.0pt;\">瑞典风味餐厅营业时间</span><span style=\"font-size: 11.0pt;\">&nbsp;</span></p>\n<p><span style=\"font-size: 11.0pt;\">工作日</span><span style=\"font-size: 11.0pt;\">10:30-20:00</span></p>\n<"
