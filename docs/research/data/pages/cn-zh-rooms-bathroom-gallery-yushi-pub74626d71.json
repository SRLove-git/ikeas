   "items": [
    {
     "title": "整洁有序的封闭式储物浴室",
     "text": "走进这间小型浴室，不禁感叹宜家 HEMNES 汉尼斯 开放式储物系列的功能十分强大。探索玻璃储物柜、洗脸池柜、储物式长凳及其他更多产品。",
     "image": "https://file.app.ikea.cn/images/55/2b/552b2411b55309c957a66a38fcebf231.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/zheng3-jie2-you3-xu4-de-feng1-bi4-shi4-chu3-wu4-yu4-shi4-pub25fe8901",
     "backgroundColor": null
    },
    {
     "title": "起床之后先洗个澡",
     "text": "看一看这个利用宜家 GODMORGON 古德莫 抽屉和储物柜收纳系列打造的浴室一角，宁静又舒适，你可在此开启新的一天，也可在此告别忙碌的一天。",
     "image": "https://file.app.ikea.cn/images/76/a8/76a8c195393ceaf3e03fe30cf52cdb82.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/qi3-chuang2-zhi1-hou4-xian1-xi3-ge4-zao3-pub660bc851",
     "backgroundColor": null
    },
    {
     "title": "条纹设计与简约朴素",
     "text": "探索设施齐全的现代化宜家浴室，里面摆放有储物式长凳、浴室用柜，以及放在水槽上方，适用于小空间的玻璃搁板。",
     "image": "https://file.app.ikea.cn/images/0e/eb/0eeb2d275c4fbc66a2e1af5a37c0aa2d.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/tiao2-wen2-she4-ji4-yu3-jian3-yue1-pu3-su4-pube6032e91",
     "backgroundColor": null
    },
    {
     "title": "儿童和客人均可使用的浴室",
     "text": "想让客人也能使用你的儿童浴室？了解我们如何规划小型浴室，让它在满足所有人需求的同时又不失独特风格。",
     "image": "https://file.app.ikea.cn/images/89/5f/895f7768de8ee7007e3ef37e01beae61.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/er2-tong2-he2-ke4-ren2-jun1-ke3-shi3-yong4-de-yu4-shi4-puba605cdc1",
     "backgroundColor": null
    },
    {
     "title": "在家中做水疗",
     "text": "浴室应该是休息、放松、享受舒适感的地方。了解这间用 BROGRUND 布鲁格隆德 和 VILTO 维尔托 系列打造出的有如水疗中心的小型浴室。",
     "image": "https://file.app.ikea.cn/images/e6/63/e66320388ea2750d8352fdb9a968e5d5.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/zai4-jia1-zhong1-zuo4-shui3-liao2-pubac598531",
     "backgroundColor": null
    },
    {
     "title": "小小浴室，十足个性",
     "text": "用明快的色彩来打造趣味浴室，同时选用能够节省空间的实用储物家具。看我们如何装饰一间小型浴室。",
     "image": "https://file.app.ikea.cn/images/17/16/17169e8778bdb447e936ca300daaad90.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/xiao3-xiao3-yu4-shi4-shi2-zu2-ge4-xing4-pub8a51f8f1",
     "backgroundColor": null
    },
    {
     "title": "打造迷你洗衣房",
     "text": "在小面积的浴室里，也可以想办法挤出一块洗衣空间。要做到这一点，就需借助可调式晾衣架、搁架和储物盒。",
     "image": "https://file.app.ikea.cn/images/0e/e9/0ee9bfbfc351ff2d66f729c2d23ff2b6.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/da3-zao4-mi2-ni3-xi3-yi1-fang2-pub69d48f21",
     "backgroundColor": null
    },
    {
     "title": "让你拥有更多意想不到的空间",
     "text": "狭小的浴室里装饰着绿色墙砖和灰色地板砖，配有白色 LILLÅNGEN 利兰根 壁柜和洗脸池柜。",
     "image": "https://file.app.ikea.cn/images/7d/d9/7dd90af8f933c4311c506770eda81df2.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/yushi-pub42dab101",
     "backgroundColor": null
    },
    {
     "title": "方便所有人使用的共享空间",
     "text": "深灰色小型浴室里摆放着 GODMORGON 古德莫 柜子、TOLKEN 托尔肯 台面和 KATTEVIK 水槽。",
     "image": "https://file.app.ikea.cn/images/3e/54/3e54c292b2ceda760cb31ff9d87cb2cf.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/yushi-pub9f5c8971",
     "backgroundColor": null
    },
    {
     "title": "井然有序的浴室更显宽敞",
     "text": "黑色、白色和黄色浴室中设有 LILLÅNGEN 利兰根/TALLEVIK 特维肯 白色双门洗脸池柜和 LILLÅNGEN 利兰根 白色高柜，储物空间非常宽敞，整体外观井井有条。",
     "image": "https://file.app.ikea.cn/images/d0/c0/d0c076306bff6f810f6fe91ef9161c35.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/yushi-pube2b7ff31",
     "backgroundColor": null
    },
    {
     "title": "打造清新实用的浴室",
     "text": "米色和灰色浴室里摆放着 RÅGRUND 罗格朗 洗脸池/转角搁板和竹制搁架单元。",
     "image": "https://file.app.ikea.cn/images/7d/d0/7dd0359e95699791a2b1505fe27dc66d.jpg",
     "href": "/cn/zh/rooms/bathroom/gallery/yushi-pub6da4d2d1",
     "backgroundColor": null
    },
    {
