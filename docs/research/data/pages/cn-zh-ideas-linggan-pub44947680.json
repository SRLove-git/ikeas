  },
  {
   "type": "pub-image",
   "title": null,
   "texts": [
    "Sara和她家人的照片。",
    "IMAGE",
    "MANUAL_INPUT"
   ],
   "images": [
    "https://file.app.ikea.cn/images/99/06/9906848e14465bea3f659f8a52bbaba2.jpg"
   ],
   "links": [
    {
     "href": "https://file.app.ikea.cn/images/99/06/9906848e14465bea3f659f8a52bbaba2.jpg",
     "text": ""
