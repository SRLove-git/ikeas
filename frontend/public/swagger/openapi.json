    "/api/v1/pages/families": {
      "get": {
        "tags": ["内容页公共读取"],
        "summary": "内容页栏目统计（family -> 页面数）",
        "responses": {
          "200": {
            "description": "各栏目页面数量，如 company=2、customer-service=3、legal=3",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "type": "integer" },
                  "example": { "company": 2, "customer-service": 3, "legal": 3 }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu-panels": {
      "get": {
        "tags": ["导航与菜单接口"],
        "summary": "顶部导航下拉菜单面板列表",
        "description": "返回顶部导航绑定下拉面板（公司介绍/组织架构/客户服务等）。导航项通过 homepage.navMenuItems[].menuPanelLabel 与面板 label 匹配；面板 links 支持 # 锚点定位页面区块。",
        "responses": {
          "200": {
            "description": "菜单面板数组",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MenuPanel" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/menu": {
      "get": {
        "tags": ["导航与菜单接口"],
        "summary": "「所有商品」分类菜单（Mega 菜单）",
        "responses": {
          "200": {
            "description": "分类菜单对象（categories 数组）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/MenuCategory" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
