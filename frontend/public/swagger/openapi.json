              }
            }
          }
        }
      }
    },
    "/api/v1/homepage/{section}": {
      "get": {
        "tags": ["首页接口"],
        "summary": "获取首页指定区块",
        "parameters": [
          {
            "name": "section",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "区块名，例如 heroVideo、navMenuItems、promoCardItems、serviceColumns"
          }
        ],
        "responses": {
          "200": {
            "description": "区块数据（JSON）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/HeroVideo" },
                    { "type": "object", "additionalProperties": true }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "区块不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/admin/pages": {
      "get": {
        "tags": ["新页面内容"],
        "summary": "查询内容页列表（公司介绍/组织架构/客户服务/法律与条款）",
        "parameters": [
          {
            "name": "family",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["company", "customer-service", "legal"] },
            "description": "栏目过滤：company = 公司介绍/组织架构；customer-service = 客户服务（含联系我们）；legal = 法律与条款（隐私政策/使用条款/在线购买协议）"
          }
        ],
        "responses": {
          "200": {
            "description": "页面列表与栏目汇总",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["新页面内容"],
        "summary": "创建内容页面",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PageData" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageData" }
              }
            }
          },
          "400": {
            "description": "参数错误（如 URL 为空）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/admin/pages/{key}": {
      "get": {
        "tags": ["新页面内容"],
        "summary": "获取内容页详情",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "页面 URL 的 base64url，如 `/zh/company` -> `L2NuL3poL2NvbXBhbnk`；`/zh/customer-service/contact-us/` -> `L2NuL3poL2N1c3RvbWVyLXNlcnZpY2UvY29udGFjdC11cy8`；`/zh/privacy-policy` -> `L2NuL3poL3ByaXZhY3ktcG9saWN5`"
          }
        ],
        "responses": {
          "200": {
            "description": "页面区块数据",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageData" }
              }
            }
          },
          "404": {
            "description": "页面不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "put": {
        "tags": ["新页面内容"],
        "summary": "更新内容页内容",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PageData" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的页面",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageData" }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["新页面内容"],
        "summary": "删除内容页",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OkResponse" }
              }
            }
          },
          "404": {
            "description": "页面不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ikea_admin_session",
        "description": "管理端登录后由服务端写入的 HttpOnly 会话 Cookie。"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未登录或会话已过期",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "OkResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      },
      "ContentBlock": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "区块类型：pub-text、corporate-hero、corporate-about、corporate-stats、corporate-timeline、corporate-policy、corporate-text（公司/组织页文字区块）、corporate-pic-text（图文版式：图片 + 治理文字 + 展开/收起）、corporate-team-tabs（成员分栏页签）、corporate-team（成员卡片网格）、contact-channels（联系渠道/门店图标卡片，items 为 ContactItem）、contact-list（联系事项列表行，items 为 ContactItem）、pub-expandable-area（问答折叠区，texts 按「问题、答案」成对排列）、support-search-hero（客户服务搜索 Hero：texts 第 1 项眉题、第 2 项副标题，links 热门服务标签，settings.placeholder 搜索占位）、support-quick-services（快捷服务图标卡片，items 为 { title, text, href, icon }）、support-assurances（服务保障图标卡，items 为 { title, text, icon }）、support-faq（可搜索问答折叠区，texts 按「问题、答案」成对排列，settings.sectionId=faq 供锚点定位）、support-contact-banner（获取帮助横幅：images 背景图，links 按钮）；settings.sectionId 为区块锚点 id（公司页：company-about / company-innovation / company-cooperation / company-timeline / company-policy；组织页：organization-overview / organization-business-units）；法律与条款页（legal）全部使用 pub-text 区块（title=章节标题，texts=章节正文）"
          },
          "title": { "type": ["string", "null"] },
          "texts": { "type": "array", "items": { "type": "string" } },
          "images": { "type": "array", "items": { "type": "string" } },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "href": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          },
          "items": {
            "type": "array",
            "description": "items 结构随区块类型变化：corporate-team-tabs 为 TeamGroup 数组（含嵌套 members）；corporate-team 为成员卡片数组 { title=姓名, text=职务, image, href }；corporate-stats 为 { value, label }；contact-channels / contact-list 为 ContactItem 数组 { title, text, href, icon, image, backgroundColor }；support-quick-services 为 { title, text, href, icon }（icon 取值见 ContactItem.icon 枚举）；support-assurances 为 { title, text, icon }。",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "example": [
              {
                "id": "board-of-directors",
                "title": "董事会",
                "description": "负责公司战略决策与整体经营方向（成员信息待定）。",
                "members": [
                  {
                    "name": "姓名待定",
                    "position": "董事长",
                    "image": null,
                    "href": null
                  }
                ]
              }
            ]
          },
          "columns": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "productIds": { "type": "array", "items": { "type": "string" } },
          "settings": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "区块扩展配置：traceId 埋点标识、videoSrc/videoPoster（corporate-about 品牌视频）、placeholder（support-search-hero / support-faq 搜索占位）、sectionId（区块锚点 id，供导航下拉 # 链接定位页面区块）"
          }
        }
      },
      "PageData": {
        "type": "object",
        "required": ["url", "family", "title", "blocks"],
        "properties": {
          "url": { "type": "string", "example": "/zh/company" },
          "family": {
            "type": "string",
            "enum": ["company", "customer-service", "legal"],
            "description": "company = 公司介绍/组织架构；customer-service = 客户服务（含联系我们）；legal = 法律与条款（隐私政策/使用条款/在线购买协议）"
          },
          "id": { "type": ["string", "null"] },
          "title": { "type": "string", "example": "公司介绍" },
          "name": { "type": ["string", "null"] },
          "hero": { "type": ["string", "null"] },
          "subtitle": {
            "type": ["string", "null"],
            "description": "页面头部 Hero 副标题（华为风格：标题 + 副文案垂直居中），当前仅联系我们页使用",
            "example": "对 BUZUD 产品、售后服务、商务合作等有任何问题，请通过这些渠道与我们联系。"
          },
          "blocks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ContentBlock" }
          }
        }
      },
      "PageListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PageData" }
          },
          "total": { "type": "integer" },
          "families": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer" }
              }
            }
          }
        }
      },
      "TeamMember": {
        "type": "object",
        "required": ["name", "position"],
        "description": "团队成员（当前姓名与头像均为占位）。",
        "properties": {
          "name": {
            "type": "string",
            "description": "姓名，当前为占位「姓名待定」。",
            "example": "姓名待定"
          },
          "position": {
            "type": "string",
            "description": "职务，如董事长、首席执行官。",
            "example": "董事长"
          },
          "image": {
            "type": ["string", "null"],
            "description": "头像图片地址；null 时前端展示占位剪影。"
          },
          "href": {
            "type": ["string", "null"],
            "description": "个人详情链接，可空。"
          }
        }
      },
      "TeamGroup": {
        "type": "object",
        "required": ["id", "title", "members"],
        "description": "成员分栏（corporate-team-tabs 区块的 items 元素）。",
        "properties": {
          "id": {
            "type": "string",
            "description": "分栏锚点 id，如 board-of-directors / supervisory-board / management-team。",
            "example": "board-of-directors"
          },
          "title": {
            "type": "string",
            "description": "分栏名称，如董事会、监事会、管理团队。",
            "example": "董事会"
          },
          "description": {
            "type": "string",
            "description": "分栏说明。"
          },
          "members": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TeamMember" }
          }
        }
      },
      "ContactItem": {
        "type": "object",
        "required": ["title", "text", "href"],
        "description": "联系我们页的渠道卡片/列表行元素（contact-channels、contact-list 区块的 items）。",
        "properties": {
          "title": { "type": "string", "example": "客服热线 / WhatsApp" },
          "text": {
            "type": "string",
            "description": "支持 \\n 换行，前端按行展示",
            "example": "+65 6518 9979 / +65 6518 9269\n周一至周五 9am-8pm；周六周日 10am-7pm"
          },
          "image": { "type": ["string", "null"] },
          "href": {
            "type": ["string", "null"],
            "description": "tel: / mailto: / 站内链接（含 # 锚点）",
            "example": "tel:+6565189979"
          },
          "icon": {
            "type": ["string", "null"],
            "enum": [
              "phone",
              "email",
              "chat",
              "store",
              "feedback",
              "partner",
              "careers",
              "report",
              "fax",
              "document",
              "shield",
              "wrench",
              "box",
              "truck",
              "gift",
              "clock",
              "badge"
            ],
            "description": "渠道/服务图标；省略时前端回退默认图标。shield=保修/正品，wrench=售后维修，box=订单，truck=配送，gift=权益，clock=时效，badge=质保"
          },
          "backgroundColor": { "type": ["string", "null"] }
        }
      },
      "MenuLink": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "公司简介" },
          "href": {
            "type": "string",
            "description": "支持站内 # 锚点定位页面区块",
            "example": "/zh/company#company-about"
          }
        }
      },
      "MenuImageCard": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "href": { "type": "string" },
          "image": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        }
      },
      "MenuColumn": {
        "type": "object",
        "properties": {
          "heading": { "type": ["string", "null"] },
          "intro": { "type": ["string", "null"] },
          "cards": { "type": "array", "items": { "$ref": "#/components/schemas/MenuImageCard" } },
          "thumbnails": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MenuImageCard" }
          },
          "links": { "type": "array", "items": { "$ref": "#/components/schemas/MenuLink" } }
        }
      },
      "MenuPanel": {
        "type": "object",
        "required": ["label", "href", "columns"],
        "description": "顶部导航下拉菜单面板（menu-panels.json）。导航项通过 homepage.navMenuItems[].menuPanelLabel 与 label 匹配；links 支持 # 锚点定位页面区块。",
        "properties": {
          "label": { "type": "string", "example": "公司介绍" },
          "href": { "type": "string", "example": "/zh/company" },
          "columns": { "type": "array", "items": { "$ref": "#/components/schemas/MenuColumn" } }
        }
      },
      "MenuSubCategory": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "早孕检测" },
          "url": { "type": "string", "example": "/zh/p/buzud-pregnancy-rapid-test-8885020710595" },
          "image": { "type": ["string", "null"] }
        }
      },
      "MenuCategory": {
        "type": "object",
        "required": ["name", "url"],
        "description": "「所有商品」分类菜单项（Mega 菜单左侧分类 + 右侧商品子分类）。",
        "properties": {
          "name": { "type": "string", "example": "快速检测试剂" },
          "url": { "type": "string", "example": "/zh/cat/buzud-rapid-tests" },
          "image": { "type": ["string", "null"] },
          "subs": { "type": "array", "items": { "$ref": "#/components/schemas/MenuSubCategory" } }
        }
      },
      "HeroVideo": {
        "type": "object",
        "required": ["poster"],
        "description": "首页首屏视频配置（heroVideo，原 heroSlides 轮播数组已移除）。video 为空/null 时前端展示「宣传视频即将上线」占位。",
        "properties": {
          "video": {
            "type": ["string", "null"],
            "description": "MP4 地址（如 /videos/buzud-home-1.mp4）；为空时展示占位",
            "example": "/videos/buzud-home-1.mp4"
          },
          "poster": {
            "type": "string",
            "description": "封面图片，视频加载前或未配置视频时的兜底图",
            "example": "/images/cms/buzud-home-1.png"
          },
          "href": { "type": ["string", "null"], "description": "首屏可点击跳转链接" },
          "alt": { "type": ["string", "null"], "description": "替代文本/视频说明" }
        }
      },
      "HomepageData": {
        "type": "object",
        "description": "首页完整数据对象（HomepageController 返回）。v1.3.0 起 heroSlides 轮播数组替换为 heroVideo 单视频对象。",
        "properties": {
          "heroVideo": { "$ref": "#/components/schemas/HeroVideo" },
          "noticeMessages": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "navMenuItems": {
            "type": "array",
            "description": "顶部导航项。hasMegaMenu=true 时悬停展示「所有商品」分类菜单；menuPanelLabel 绑定下拉面板（对应 GET /api/v1/menu-panels 返回面板的 label），留空则不显示面板下拉。",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "example": "公司介绍" },
                "href": { "type": "string", "example": "/zh/company" },
                "hasMegaMenu": { "type": "boolean", "example": false },
                "menuPanelLabel": { "type": ["string", "null"], "example": "公司介绍" }
              }
            }
          },
          "promoCardItems": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "serviceColumns": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      }
    }
  },
  "security": [
    {
      "cookieAuth": []
    }
  ]
}
